# shieldscan-engine — worker environment template
#
# NOTE: This file deliberately excludes any database credentials.
# Workers do not connect to PostgreSQL per ADR-013. If you find
# yourself adding DATABASE_URL, POSTGRES_*, DB_*, or PG_* here,
# you're violating the architectural commitment — see ADR-013.
# The buildguard test TestWorkerBinary_DoesNotImportPostgresDriver
# enforces this at the build-graph level.

# === Worker identity ===
SHIELDSCAN_WORKER_ID=worker-local-01

# === Worker tuning ===
# Concurrent jobs per worker process. Default 5 (per SPEC §11
# "Concurrent scans per worker"). Env-var configurable so M8's
# per-job tool-fanout can adjust without code changes (ADR-021).
SHIELDSCAN_WORKER_CONCURRENCY=5

# === Redis (queue + progress + cancel + completions) ===
# Redis requires a password. Note the EMPTY username and leading colon:
#   redis://:<password>@host:port/db
# Must match REDIS_PASSWORD in shieldscan-api/.env — a mismatch here makes
# the worker exit at phase 0 (redis ping) rather than consume jobs.
SHIELDSCAN_REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@localhost:6379/0

# === Cloudflare R2 (mobile artifact downloads, future findings staging) ===
SHIELDSCAN_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
SHIELDSCAN_R2_ACCESS_KEY_ID=
SHIELDSCAN_R2_SECRET_ACCESS_KEY=
SHIELDSCAN_R2_BUCKET=shieldscan-uploads

# === Logging ===
# zerolog level: trace | debug | info | warn | error | fatal | panic
SHIELDSCAN_LOG_LEVEL=info

# === Sentry (optional) ===
SHIELDSCAN_SENTRY_DSN=

# === Nikto ===
#
# apt's Nikto (2.1.5, from 2015) CANNOT scan an HTTPS target. Measured with
# Net::SSLeay 1.94 and IO::Socket::SSL 2.085 installed, so it is not a
# missing Perl module:
#
#   2.1.5  -h host:443       → plain HTTP to the TLS port. nginx answers
#                              "400 The plain HTTP request was sent to HTTPS
#                              port", and nikto reports THAT page's headers.
#   2.1.5  -h https://host/  → identical; the URL form does not help.
#   2.1.5  -h host:443 -ssl  → "No web server found", 0 hosts tested.
#   2.5.0  -h host:443       → still plain HTTP. The port is never the tell.
#   2.5.0  -h https://host/  → WORKS. sitename reads https://host:443/.
#
# For the life of this deployment, every nikto finding on every HTTPS scan
# described that error page. The job completed, the count was non-zero, the
# findings had titles — there was nothing to notice.
#
# So point the worker at a 2.5.0 built from source, not at /usr/bin/nikto.
# Absolute path to nikto.pl in the unpacked source tree, e.g.
# $HOME/.local/nikto-2.5.0/nikto.pl. See REBUILD-RUNBOOK.md §3.2.
SHIELDSCAN_NIKTO_BINARY=

# Unset makes nikto REFUSE every https:// target, recording a failed job
# carrying the reason rather than scanning. Set it to 1 ONLY after checking
# that the XML sitename of a real scan reads https:// and not http://.
SHIELDSCAN_NIKTO_TLS_CAPABLE=1

# === Target guard (nmap only) ===
#
# Comma-separated CIDRs treated as ShieldScan infrastructure by nmap's
# validateTarget. HOST-SPECIFIC: set it to the address of the machine you are
# deploying, and do NOT inherit another deployment's value.
#
# Scope it to /32 (or the exact addresses you own). On a VPS the interface's
# /24 is the PROVIDER's subnet — the other ~253 addresses belong to unrelated
# customers, some of whom may be legitimate scan targets, and blocking them is
# both wrong and invisible to whoever wonders why a scan returned nothing.
#
# WHAT THIS ACTUALLY BLOCKS: IP-LITERAL targets inside the listed ranges, and
# nothing else. It does NOT protect the platform. validateTarget classifies IP
# literals only; a hostname returns early, so a target that RESOLVES to an
# address in these ranges passes straight through — which is how ShieldScan's
# own self-scans of this host work today. It also applies to nmap alone: zap
# checks private/link-local/loopback with the same hostname bypass and has no
# infra concept, and the remaining tools have no target guard at all.
#
# Unset (the default) makes the check a no-op that always returns false.
SHIELDSCAN_INFRA_CIDRS=
